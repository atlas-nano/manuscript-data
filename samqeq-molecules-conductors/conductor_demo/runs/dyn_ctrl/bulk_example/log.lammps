  reading angles ...
  256 angles
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     1 = max # of 1-3 neighbors
     1 = max # of 1-4 neighbors
     2 = max # of special neighbors
  special bonds CPU = 0.000 seconds
  read_data CPU = 0.009 seconds

group           watO  type 1
256 atoms in group watO
group           watH  type 2
512 atoms in group watH
group           watM  type 3
256 atoms in group watM
group           fq    type 2 3
768 atoms in group fq

# LJ on O-O only (Table I): eps=0.2862 kcal/mol=0.012412 eV, sigma=3.159 A
pair_style      hybrid/overlay lj/cut 10.0 coul/long 10.0 coul/shield/intra 5.0 all gaussian
pair_coeff      1 1 lj/cut 0.012412 3.159
pair_coeff      1 2 lj/cut 0.0 1.0
pair_coeff      1 3 lj/cut 0.0 1.0
pair_coeff      2 2 lj/cut 0.0 1.0
pair_coeff      2 3 lj/cut 0.0 1.0
pair_coeff      3 3 lj/cut 0.0 1.0
pair_coeff      * * coul/long
pair_coeff      1 1 coul/shield/intra 0.315328
pair_coeff      2 2 coul/shield/intra 0.404355
pair_coeff      3 3 coul/shield/intra 0.315328
pair_coeff      1 2 coul/shield/intra 0.357078
pair_coeff      1 3 coul/shield/intra 0.315328
pair_coeff      2 3 coul/shield/intra 0.357078
# ^ s38 FIX: hybrid/overlay contributes ZERO for unset sub-style cross pairs (no auto init_one
#   mixing, no warning) — the unset M-H pair hid a +3.2 eV/mol pe error (U_bind -82 naive / -13.6
#   'corrected' -> -9.90 = Rick EXACT once fixed). Cross values: sqrt-mixed (used by cbrt mode;
#   pqeq/slater kernels read type diagonals only). See ubind/DIAGNOSIS_UBIND.md.

special_bonds   lj/coul 1.0e-8 1.0e-8 1.0
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    1e-08    1e-08    1       
  special bond factors coul:  1e-08    1e-08    1       
     2 = max # of 1-2 neighbors
     1 = max # of 1-3 neighbors
     2 = max # of special neighbors
  special bonds CPU = 0.000 seconds
kspace_style    pppm/samqeq 1.0e-5

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

fix             chg fq qeq/sam 1 0.0 10.0 1.0e-5 water4_liquid_gauss.param
fix_modify      chg shield gaussian
samqeq: lr-solve shielding = PQEq Gaussian erf(a_ij r)/r (param 4th col = Rc (Gaussian radius)); routed through compute_H + add_fixed_charge_field + the legacy gas path (calc_Hval)
fix_modify      chg energy yes
# ROOT CAUSE (found via a dt-scan diagnostic, in.diag_dt.tmp/in.diag_dt2.tmp, logs
# log.diag_dt/log.diag_dt2): dt=0.5 fs (the task's suggested value) is NOT a stable
# integration step for this system -- the intramolecular M-H charge oscillator is very
# stiff (r_MH=0.87 A, eta_M/H~16/15 eV) and the rigid-body torque response amplifies any
# discretization error into a genuine near-critical SCF catastrophe within a few hundred
# steps (confirmed: NEITHER an offset-quartic wall NOR the rnd charge-freeze safeguard
# cured it at dt=0.5fs -- both only delayed/relocated the same blow-up, proof this is an
# INTEGRATION-timestep problem, not a kernel-fit or Hessian-singularity problem). At
# dt=0.1 and dt=0.2 fs the SAME deck (no stabilizers needed at all) is fully stable over
# the tested window with mu/qM/qH/T all physically sane and drifting toward the targets.
# Using dt=0.2 fs (4x smaller than the task's suggested 0.5 fs) here.

compute         qMpa watM property/atom q
compute         qMc  watM reduce ave c_qMpa
compute         qHpa watH property/atom q
compute         qHc  watH reduce ave c_qHpa
compute         dip all dipole/samqeq
variable        mu   equal c_dip
variable        qM   equal c_qMc
variable        qH   equal c_qHc
variable        pemol equal pe/256.0
variable        T equal temp
variable        P equal press

timestep        0.0002
velocity        all create 298.0 65491 mom yes rot yes dist gaussian
fix             rig all rigid/nvt/small molecule temp 298.0 298.0 0.02
Fix rigid/nvt/small setup ...
  create bodies CPU = 0.000 seconds
  256 rigid bodies with 1024 atoms
  0.87348128 = max distance from body owner to body atom

thermo          250
thermo_style    custom step temp press density pe v_pemol v_mu v_qM v_qH
thermo_modify   flush yes

# --- tail-window averages inside the ONE run (last ~1 ps of a 3 ps / 15000-step run) ---
compute         rdfOO all rdf 100 1 1
fix             rdfavg all ave/time 50 100 15000 c_rdfOO[*] file oo_rdf.dat mode vector
fix             propavg all ave/time 25 200 15000 v_mu v_qM v_qH v_T v_P v_pemol ave one file props_tail.dat

dump            tr all custom 1000 tip4pfq_liquid.lammpstrj id type xu yu zu q
run             5000

