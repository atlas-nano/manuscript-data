# samQEq example: SPC-FQ fluctuating-charge water (long-range Ewald, lr_ewald=2).
#
# A condensed-phase fluctuating-charge water model: the charges respond self-consistently to the
# instantaneous environment with full Ewald electrostatics. spcfq_expt.param is fit to the exact
# experimental monomer dipole (1.855 D) with the O-O LJ refit to the liquid density; it reproduces
# rho ~ 0.994 g/cc, liquid dipole ~2.80 D, and 3PT entropy ~66.7 J/mol/K (NIST 69.9). See the
# top-level README for details.
#
# This deck does a single-point charge equilibration on a small liquid cell and reports the per-atom
# charges + system dipole. For dynamics, add an integrator (e.g. `fix integ all rigid/nve/small
# molecule`) and optionally extended-Lagrangian charges (`fix_modify chg xl 5.0e-5 0.5`).

units        metal
atom_style   full
boundary     p p p
lattice      sc 3.1
region       box block 0 4 0 4 0 4
create_box   2 box
mass         1 15.9994        # O
mass         2 1.008          # H
molecule     h2o spcfq.mol
create_atoms 0 box mol h2o 12345
group        fq type 1 2
set          type 1 charge -0.85
set          type 2 charge  0.425

pair_style   hybrid/overlay lj/cut 10.0 coul/long 10.0 coul/shield/intra 5.0 all # added 'all'
pair_coeff   1 1 lj/cut 0.01275 3.176
pair_coeff   1 2 lj/cut 0.0 1.0
pair_coeff   2 2 lj/cut 0.0 1.0
pair_coeff   * * coul/long
pair_coeff   * * coul/shield/intra 1.11    # match the param gamma column
kspace_style pppm/samqeq 1.0e-6
neighbor     2.0 bin
neigh_modify every 1 delay 0 check yes # added

fix          chg fq qeq/sam 1 0.0 10.0 1.0e-5 spcfq_expt.param
fix_modify   chg energy yes # added
fix_modify   chg recip_probes 16 # added

compute      dip fq dipole/samqeq
thermo_style custom step c_dip cpu etotal temp
thermo       100

timestep     0.001
velocity     all create 298 123456 mom yes rot yes dist gaussian

# NVT Equilibration
dump         5 all custom 100 nvt1.lammpsdump id type mol xu yu zu vx vy vz q
fix          integ all rigid/nvt/small molecule temp 298 298 0.1
run          50000
undump       5
unfix        integ

# NPT Equilibration
variable             latx equal lx
variable             laty equal ly
variable             latz equal lz
fix                  lxavg all ave/time 1 250000 250000 v_latx
fix                  lyavg all ave/time 1 250000 250000 v_laty
fix                  lzavg all ave/time 1 250000 250000 v_latz

dump         6 all custom 100 npt.lammpsdump id type mol xu yu zu vx vy vz q
fix          integ all rigid/npt/small molecule temp 298 298 0.1 iso 1.01325 1.01325 1
run          500000
undump       6
unfix        integ

variable             xavg equal f_lxavg
variable             yavg equal f_lyavg
variable             zavg equal f_lzavg
print                "current cell: ${latx} ${laty} ${latz} cell avgs: ${xavg} ${yavg} ${zavg}"
print                "deforming cell"
fix                  integ all rigid/nvt/small molecule temp 298 298 0.1 
dump                 7 all custom 5000 deform.lammps id type mol xu yu zu vx vy vz q
fix                  def all deform 100 x final 0 ${xavg} y final 0 ${yavg} z final 0 ${zavg} units box
unfix                lxavg
unfix                lyavg
unfix                lzavg
run                  100000
undump               7
unfix                integ
unfix                def

#NVT Equilibration
dump         8 all custom 100 nvt2.lammpsdump id type mol xu yu zu vx vy vz q
fix          integ all rigid/nvt/small molecule temp 298 298 0.1
run          100000
undump       8
unfix        integ


#NVE Production
reset_timestep 0
timestep     0.001

fix          integ all rigid/nve/small molecule
dump         9 all custom 100 nve.lammpsdump id type mol xu yu zu vx vy vz q
run          300000
undump       9
unfix        integ

print        "SPC-FQ water: system dipole magnitude = $(c_dip)"
