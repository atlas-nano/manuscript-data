# route-2 kernel comparison: TIP4P-FQ monomer, cubic periodic box L=40, pppm/samqeq, kernel = cbrt
units           metal
atom_style      full
boundary        p p p
variable        h equal 0.5*40
region          box block $(-v_h) $(v_h) $(-v_h) $(v_h) $(-v_h) $(v_h)
create_box      3 box
mass            1 15.9994
mass            2 1.008
mass            3 1.0e-6
molecule        h2o /home/tpascal/manuscripts_todo/ms_alphasigma_overleaf/gasphase_route2_20260916/kernel/water4.mol
create_atoms    0 single 0.0 0.0 0.0 mol h2o 1
group           fq type 2 3
pair_style      hybrid/overlay lj/cut 12.0 coul/long 12.0 coul/shield/intra 12.0 all cbrt
pair_coeff      * * lj/cut 0.0 1.0
pair_coeff      1 1 lj/cut 0.0124 3.159
pair_coeff      * * coul/long
pair_coeff      1 1 coul/shield/intra 3.0803
pair_coeff      2 2 coul/shield/intra 1.7007
pair_coeff      3 3 coul/shield/intra 3.0803
kspace_style    pppm/samqeq 1.0e-6
kspace_modify   gewald 0.35 mesh 40 40 40 order 5
neighbor        2.0 bin
fix             chg fq qeq/sam 1 0.0 12.0 1.0e-10 /home/tpascal/manuscripts_todo/ms_alphasigma_overleaf/gasphase_route2_20260916/kernel/water4_r2.param
fix_modify      chg shield cbrt
fix_modify      chg solver cg nofallback
fix_modify      chg recip_self peratom
compute         dip all dipole/samqeq
run             0
variable        qM  equal q[4]
variable        qH1 equal q[2]
variable        qH2 equal q[3]
variable        mu  equal c_dip
print "RESULT_R2 kernel=cbrt L=40 qM=$(v_qM:%.6f) qH1=$(v_qH1:%.6f) qH2=$(v_qH2:%.6f) mu_D=$(v_mu:%.6f) pe=$(pe:%.6f) ecoul=$(ecoul:%.6f) elong=$(elong:%.6f) fchg=$(f_chg:%.6f) evdwl=$(evdwl:%.6f)"
write_dump      all custom charges_cbrt_L40.dump id type q modify sort id format line "%d %d %.12g"
