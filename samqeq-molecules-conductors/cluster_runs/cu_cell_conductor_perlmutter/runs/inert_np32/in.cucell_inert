# the published benchmark deck, unchanged (copper atoms are single-atom fragments held at q0 = 0)
# Benchmark deck for proc-grid optimization: reads data.cell_L0, steady 300 K, short run.
# Same physics/cost as the production relax/equil (FQ solve + rexpon + EAM + SHAKE), with the load
# balance the inhomogeneous slab+vacuum cell needs.  Reports Loop time / Performance (timesteps/s).
#   run: srun ... lmp_cpu -in in.cucell_bench -var NB 500 [-var GRID "* * 1"]
variable        NB     index 500
variable        RIDGE  index 69.1815
units           real
atom_style      full
boundary        p p p
comm_style      tiled                     # slab+vacuum -> RCB load balance
if "${GRID} != none" then "processors ${GRID}"
special_bonds   lj/coul 1.0e-8 1.0e-8 1.0
read_data       data.cell_L0.data extra/special/per/atom 2

group           water  type 1 2
group           watO   type 1
group           zn     type 3
group           cl     type 4
group           li     type 6
group           metal  type 7
group           ions   type 3 4 6
group           mobile type 1 2 3 4 6
group           FQ     type 1 2 3 5 7
set             type 1 charge -0.9
set             type 2 charge 0.45
set             group zn charge 2.0
set             group cl charge -1.0
set             group metal charge 0.0

pair_style      hybrid/overlay rexpon NULL lgvdw yes coulomb_off yes checkqeq no safezone 3.0 mincap 200 lj/cut 10.0 coul/long 10.0 coul/shield/intra 5.0 all gaussian eam/alloy
pair_coeff      * * rexpon ffield.RexPoN Ow Hw NULL NULL NULL NULL NULL
pair_coeff      * * coul/long
pair_coeff      * * coul/shield/intra 0.5
pair_coeff      * * lj/cut 0.0 1.0
pair_coeff      * * eam/alloy CuZn.eam.alloy NULL NULL Zn NULL Zn NULL Cu
pair_coeff      1 3 lj/cut 2.30605 2.01
pair_coeff      1 4 lj/cut 1.15    3.20
pair_coeff      1 6 lj/cut 0.30    2.05
pair_coeff      1 5 lj/cut 0.9224  1.853
pair_coeff      2 5 lj/cut 0.4612  2.0
pair_coeff      3 4 lj/cut 15.0    2.04
pair_coeff      4 4 lj/cut 0.0128  4.478
pair_coeff      4 6 lj/cut 0.0655  2.944
pair_coeff      6 6 lj/cut 0.335   1.409
pair_coeff      3 6 lj/cut 0.10    2.00
pair_coeff      4 5 lj/cut 0.10    2.60
pair_coeff      5 6 lj/cut 0.10    1.80
pair_coeff      1 7 lj/cut 1.153   1.83
pair_coeff      2 7 lj/cut 0.4612  2.0
pair_coeff      4 7 lj/cut 0.10    2.60
pair_coeff      6 7 lj/cut 0.10    1.80

bond_style      harmonic
angle_style     harmonic
bond_coeff      1 0.0 0.9572
angle_coeff     1 0.0 104.52
kspace_style    pppm/samqeq 1.0e-5
kspace_modify   gewald 0.30
neighbor        2.0 bin
neigh_modify    every 2 delay 4 check yes one 10000
fix             shk all shake 1.0e-4 50 0 b 1 a 1

fix             chg FQ qeq/sam 1 0.0 8.0 1.0e-5 cucell.param
fix_modify      chg shield gaussian
fix_modify      chg quartic watO 115.30 0.0 8 0.5
fix_modify      chg ridge eig ${RIDGE} 15 10
fix_modify      chg energy yes
fix_modify      chg aspc 2 3

compute         Tw water temp
thermo          100
balance         1.0 rcb
fix             bal all balance 1000 1.05 rcb

fix             fzM  metal setforce 0 0 0
velocity        mobile create 300.0 12345 mom yes rot yes dist gaussian loop geom
fix             intg mobile nve/limit 0.1
fix             lgv  mobile langevin 300.0 300.0 100.0 12345
fix             zmom mobile momentum 100 linear 0 0 1
timestep        0.25
thermo_style    custom step pe c_Tw
run             ${NB}
