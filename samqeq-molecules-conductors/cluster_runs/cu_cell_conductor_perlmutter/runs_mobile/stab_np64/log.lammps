velocity        mobile create 300.0 12345 mom yes rot yes dist gaussian loop geom
fix             intg mobile nve/limit 0.1
fix             lgv  mobile langevin 300.0 300.0 100.0 12345
fix             zmom mobile momentum 100 linear 0 0 1
timestep        0.25
group           elA  molecule 90001
800 atoms in group elA
group           elB  molecule 90002
800 atoms in group elB
compute         qA elA property/atom q
compute         qB elB property/atom q
compute         sA elA reduce sum c_qA
compute         sB elB reduce sum c_qB
variable        aqM atom abs(q)
compute         mxM metal reduce max v_aqM
compute         TM metal temp
compute         msdM metal msd
thermo_style    custom step pe c_Tw c_TM c_msdM[4] c_sA c_sB c_mxM
run             ${NB}
run             20000

