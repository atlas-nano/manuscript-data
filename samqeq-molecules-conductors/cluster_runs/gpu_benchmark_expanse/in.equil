# Native SPC-FQ water (paper Section sec:water), 512 molecules, SHAKE-constrained SPC geometry.
# Equilibrates the base box for the host-vs-device throughput benchmark and writes base.data.
# Model identical to examples/water_native/in.npt_canon except: SHAKE instead of rigid/small (the
# only way to keep the integrator on the device under -sf kk), NVT at the lattice density, and the
# default deterministic recip_self calibration instead of the geometry-specific pin.
# special_bonds 1/1/1 keeps every intramolecular pair in the pair styles at full weight, exactly as
# in the bond-free original.
variable        NEQ index 5000
units           metal
atom_style      full
boundary        p p p
lattice         sc 3.1
region          box block 0 8 0 8 0 8
create_box      2 box bond/types 1 angle/types 1 extra/bond/per/atom 2 extra/angle/per/atom 1 extra/special/per/atom 2
special_bonds   lj/coul 1.0 1.0 1.0
mass            1 15.9994
mass            2 1.008
molecule        h2o spcfq_bonded.mol
create_atoms    0 box mol h2o 12345
bond_style      zero
bond_coeff      1 1.0
angle_style     zero
angle_coeff     1 109.47
group           fq type 1 2
pair_style      hybrid/overlay lj/cut 10.0 coul/long 10.0 coul/shield/intra 5.0 all
pair_coeff      1 1 lj/cut 0.01275 3.144
pair_coeff      1 2 lj/cut 0.0 1.0
pair_coeff      2 2 lj/cut 0.0 1.0
pair_coeff      * * coul/long
pair_coeff      * * coul/shield/intra 1.11
kspace_style    pppm/samqeq 1.0e-6
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
fix             chg fq qeq/sam 1 0.0 10.0 1.0e-5 spcfq_expt.param
fix             shk all shake 1.0e-4 100 0 b 1 a 1
velocity        all create 298.0 4928459 mom yes rot yes dist gaussian loop geom
timestep        0.001
fix             nvt all nvt temp 298.0 298.0 0.1
compute         dip fq dipole/samqeq
thermo_style    custom step temp press pe etotal c_dip
thermo          500
run             ${NEQ}
write_data      base.data nocoeff
print           "EQUIL_DONE"
