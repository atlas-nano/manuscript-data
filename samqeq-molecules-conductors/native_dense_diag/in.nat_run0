# Single-point charge solve (run 0) of the NATIVE fluctuating-charge water of Section sec:water on a
# stored frame, at a tight CG tolerance, dumping the solved charges with 17 significant digits.
# Model lines are those of /home/tpascal/codes/samQEq/examples/samqeq/in.npt_canon (512 molecules,
# coul/shield/intra 5.0 all, pair_coeff 1.11, pppm/samqeq, swb 10.0, recip_self pinned 0.37933).
#   -var data <data file>   frame written by write_data (e.g. ../tolscan_npt_20260916/npt.data)
#   -var acc  <pppm accuracy>   1.0e-6 is the deck value; 1.0e-8 tests the particle-mesh limit
#   -var tol  <qeq/sam tolerance>   1.0e-10 here (deck value 1.0e-5)
#   -var tag  <label>
variable         data  index none
variable         start index lattice
variable         acc  index 1.0e-6
variable         tol  index 1.0e-10
variable         tag  index nat_a6

units            metal
atom_style       full
boundary         p p p

if "${start} == lattice" then &
  "lattice sc 3.1" &
  "region box block 0 8 0 8 0 8" &
  "create_box 2 box" &
  "mass 1 15.9994" &
  "mass 2 1.008" &
  "molecule h2o spcfq.mol" &
  "create_atoms 0 box mol h2o 12345" &
  "set type 1 charge -0.85" &
  "set type 2 charge 0.425" &
else &
  "read_data ${data}"

group            fq type 1 2

pair_style       hybrid/overlay lj/cut 10.0 coul/long 10.0 coul/shield/intra 5.0 all
pair_coeff       1 1 lj/cut 0.01275 3.144
pair_coeff       1 2 lj/cut 0.0 1.0
pair_coeff       2 2 lj/cut 0.0 1.0
pair_coeff       * * coul/long
pair_coeff       * * coul/shield/intra 1.11
kspace_style     pppm/samqeq ${acc}
# -var gew <g_ewald>: pin the Ewald splitting (production tunes it once at ITS run start, from the
# 24.8 A lattice box and the +-0.85/0.425 seed charges: 0.33957131; an un-pinned run 0 on the NPT
# frame would retune it and shift every eigenvalue by qqrd2e*2/sqrt(pi)*(a - a_prod) through the pin)
variable         gew  index 0
variable         mesh index 0
if "${gew} > 0" then "kspace_modify gewald ${gew}"
if "${mesh} > 0" then "kspace_modify mesh ${mesh} ${mesh} ${mesh}"
neighbor         2.0 bin

fix              chg fq qeq/sam 1 0.0 10.0 ${tol} spcfq_expt.param
fix_modify       chg recip_self 0.37933
fix_modify       chg solver cg nofallback

thermo_style     custom step pe ecoul elong evdwl press
thermo_modify    format float %.12g

dump             d1 all custom 1 frame_${tag}.dump id mol type q x y z
dump_modify      d1 sort id format line "%d %d %d %.17g %.17g %.17g %.17g"

reset_timestep   0
run              0
print            "RUN0_DONE tag=${tag} acc=${acc} tol=${tol} pe=$(pe:%.12g)"
