units                real
atom_style           full
boundary             p p p
dielectric           1
special_bonds        lj/coul 0.0 0.0 1.0
pair_style           lj/cut/tip4p/long/opt 1 2 1 1 0.1577 11 10

bond_style           harmonic
angle_style          harmonic
dihedral_style       none
improper_style       none
kspace_style         pppm/tip4p 1e-06

read_data            data.tip-ice

pair_modify          mix geometric
neighbor             2.0 multi
neigh_modify         every 1 delay 0 check yes
thermo_style         multi
thermo_modify        line multi format float %14.6f flush yes
variable             input string in.tip-ice
variable             sname string tip-ice


timestep             1
                     
                     
print                .
print                ==========================================
print                "500 steps CG Minimization"
print                ==========================================
print                .
                     
dump                 1 all custom 25 ${sname}.min.lammps id type xu yu zu vx vy vz
thermo               10
min_style            sd
minimize             1.0e-4 1.0e-4 500 5000
min_style            cg
minimize             1.0e-4 1.0e-4 500 5000
#now                 minimize the entire system
minimize             1.0e-4 1.0e-4 500 5000
undump               1
                     
                     
print                .
print                =====================================
print                "NVT dynamics to heat system"
print                =====================================
print                .
                     
reset_timestep       0
fix                  shakeH all shake 0.0001 20 500 m 1.0079 a 1
velocity             all create 0.0 1337420 dist uniform
thermo               100
dump                 1 all custom 1000 ${sname}.heat.lammpstrj id type xu yu zu vx vy vz
fix                  3 all nvt temp 1.0 ${rtemp} 100.0
run                  10000
unfix                3
unfix		     shakeH
undump               1

print                .
print                ================================================
print                "NVT production dynamics "
print                ================================================
print                .

fix                  shakeH all shake 0.0001 20 500 t 2 a 1
fix                  2 all nvt temp ${rtemp} ${rtemp} 100.0 tloop 10 ploop 10
restart              50000 ${sname}.${rtemp}K.*.restart
dump                 1 all custom 1000 ${sname}.${rtemp}K.prod.lammps id type xu yu zu vx vy vz
run                  1000000 # run for 1 ns
write_data           data.nvt_01
run                  1000000 # run for 1 ns
write_data           data.nvt_02
run                  1000000 # run for 1 ns
write_data           data.nvt_03
run                  1000000 # run for 1 ns
write_data           data.nvt_04
run                  1000000 # run for 1 ns
write_data           data.nvt_05
run                  1000000 # run for 1 ns
write_data           data.nvt_06
run                  1000000 # run for 1 ns
write_data           data.nvt_07
run                  1000000 # run for 1 ns
write_data           data.nvt_08
run                  1000000 # run for 1 ns
write_data           data.nvt_09
run                  1000000 # run for 1 ns
write_data           data.nvt_10
unfix                2
unfix                shakeH
undump               1

