UNITS LENGTH=A ENERGY=eV TIME=ps
an: COM ATOMS=1721-1777
li: COM ATOMS=1778
d:  DISTANCE ATOMS=an,li
uw: UPPER_WALLS ARG=d AT=12.0 KAPPA=5.0 EXP=2
lw: LOWER_WALLS ARG=d AT=2.0  KAPPA=5.0 EXP=2
opes: OPES_METAD ...
  ARG=d
  PACE=500
  BARRIER=0.7575
  SIGMA=0.100
  TEMP=293.0
  WALKERS_MPI
  FILE=KERNELS
...
PRINT ARG=d,opes.bias,opes.rct,opes.zed,opes.neff FILE=COLVAR STRIDE=500
FLUSH STRIDE=500
