UNITS LENGTH=A ENERGY=eV TIME=ps
WHOLEMOLECULES ENTITY0=3206-3262
an:  COM ATOMS=3206-3262
li:  COM ATOMS=3263
dan: DISTANCE ATOMS=an,li
lwan: LOWER_WALLS ARG=dan AT=10.0 KAPPA=5.0 EXP=2
dminan: DISTANCES GROUPA=3263 GROUPB=3206-3262 LOWEST
cnan:   COORDINATION GROUPA=3263 GROUPB=3206-3262 SWITCH={RATIONAL R_0=3.4 D_0=0.0 NN=48 MM=96 D_MAX=6.0}
don: GROUP ATOMS=1-3201:5
cn:   COORDINATION GROUPA=3263 GROUPB=don SWITCH={RATIONAL R_0=2.28 D_0=0.0 NN=6 MM=12 D_MAX=6.0}
cn12: COORDINATION GROUPA=3263 GROUPB=don SWITCH={RATIONAL R_0=2.28 D_0=0.0 NN=12 MM=24 D_MAX=6.0}
ncount: COORDINATION GROUPA=3263 GROUPB=don SWITCH={RATIONAL R_0=3.00 D_0=0.0 NN=48 MM=96 D_MAX=5.0}
uwcn: UPPER_WALLS ARG=cn AT=5.8 KAPPA=2.0 EXP=2
opes: OPES_METAD ...
  ARG=cn
  PACE=500
  BARRIER=1.0100
  SIGMA=0.29
  TEMP=293.0
  WALKERS_MPI
  FILE=KERNELS
...
PRINT ARG=cn,cn12,ncount,dan,dminan.lowest,cnan,lwan.bias,uwcn.bias,opes.bias,opes.rct,opes.zed,opes.neff FILE=COLVAR STRIDE=500
FLUSH STRIDE=500
